# Exemplo local de configuracao do BFF, sem tokens nem senhas.
# Copie para backend/.env e ajuste apenas o ambiente que voce controla.
# O comando Uvicorn deve ser executado dentro de backend/.
#
# Modulo 3: consultas GET sempre saem do BFF, nunca do navegador.
MODULE3_ENABLED=true
MODULE3_URL=https://modulo3-fhgjdpa6d5bbfvff.canadacentral-01.azurewebsites.net
MODULE3_TIMEOUT_SECONDS=8
#
# Mapeamento: projeto autorizado no Modulo 1 -> projeto do Modulo 3.
# Ative SOMENTE apos confirmar com o grupo que representam o mesmo projeto.
# Descomente esta linha para testar o projeto informado em 27/11/2026:
# MODULE3_PROJECT_MAP=f092329c-0747-4b88-92f0-c3036786ce91=3
#
# Outros servicos podem continuar com mock sem afetar esta integracao:
USE_MOCKS=true
